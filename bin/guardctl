#!/bin/sh
set -eu

export GUARDCTL_CWD="$PWD"
repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$repo_dir/controller"

# `--` stops Node from interpreting CLI options of the same name
# (`--env-file`, `--input-type`, ...) before guardctl parses them.
exec node --import tsx -- src/cli/guardctl.ts "$@"
