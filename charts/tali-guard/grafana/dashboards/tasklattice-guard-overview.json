        {"editorMode": "code", "expr": "sum(guardrail:checks:rate5m{guardrail_id!~\"__unmatched__|__unresolved__\",endpoint_id!~\"__unmatched__|__unresolved__\",guardrail_id=~\"$guardrail\",endpoint_id=~\"$endpoint\",runner_id=~\"$runner\"})", "legendFormat": "total", "range": true, "refId": "E"}
