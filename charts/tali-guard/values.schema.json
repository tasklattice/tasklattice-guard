{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["controller", "controlPlaneAgent", "models", "evaluators", "runner", "database", "postgresql", "redis", "security"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "imagePullSecrets": {"type": "array"},
    "rolloutRevision": {"type": "string"},
    "controller": {
      "type": "object",
      "required": ["replicaCount", "image", "publicUrl", "trustedOrigins", "auth", "service"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1, "maximum": 1},
        "publicUrl": {"type": "string", "pattern": "^https?://"},
        "trustedOrigins": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^https?://"}
        },
        "auth": {
          "type": "object",
          "required": ["minPasswordLength", "allowLocalDefaultCredentials"],
          "properties": {
            "minPasswordLength": {"type": "integer", "minimum": 5, "maximum": 128},
            "allowLocalDefaultCredentials": {"type": "boolean"}
          }
        },
        "image": {"$ref": "#/definitions/image"},
        "service": {
          "type": "object",
          "required": ["type", "httpPort", "grpcPort", "public"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "httpPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "grpcPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "public": {
              "type": "object",
              "required": ["enabled", "type", "port"],
              "properties": {
                "enabled": {"type": "boolean"},
                "type": {"type": "string", "enum": ["NodePort", "LoadBalancer"]},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        }
      }
    },
    "controlPlaneAgent": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "object",
          "required": ["name", "baseUrl", "model", "apiKey", "existingSecret", "secretKey"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "baseUrl": {"type": "string"},
            "model": {"type": "string"},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "models": {
      "type": "object",
      "required": ["runtimes", "credentials"],
      "properties": {
        "runtimes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "base_url", "model"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "client": {"type": "string", "enum": ["openai_chat"]},
              "base_url": {"type": "string", "pattern": "^https?://"},
              "model": {"type": "string", "minLength": 1},
              "api_key_env_var": {"type": "string", "minLength": 1},
              "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
              "max_tokens": {"type": "integer", "minimum": 1}
            }
          }
        },
        "credentials": {
          "type": "object",
          "required": ["existingSecret", "values"],
          "properties": {
            "existingSecret": {"type": "string"},
            "values": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "evaluators": {
      "type": "object",
      "required": ["bindings", "automatedReasoning"],
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "contract_ref", "profile_ref", "model_ref"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "contract_ref": {"type": "string", "minLength": 1},
              "profile_ref": {"type": "string", "enum": ["tali.qwen3guard.v1", "tali.llama-guard-3.v1", "tali.taxonomy-judge.v1"]},
              "model_ref": {"type": "string", "minLength": 1},
              "priority": {"type": "integer"}
            }
          }
        },
        "automatedReasoning": {
          "type": "object",
          "required": ["endpointUrl", "apiKey", "existingSecret", "secretKey"],
          "properties": {
            "endpointUrl": {"type": "string"},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "required": ["image", "default", "pools", "service", "callContextRedisUrl"],
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "default": {
          "type": "object",
          "required": ["replicaCount", "maxConcurrency"],
          "properties": {
            "replicaCount": {"type": "integer", "minimum": 2},
            "maxConcurrency": {"type": "integer", "minimum": 1}
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "replicaCount", "maxConcurrency", "resources"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
              "replicaCount": {"type": "integer", "minimum": 1},
              "maxConcurrency": {"type": "integer", "minimum": 1},
              "compilerCapable": {"type": "boolean"}
            }
          }
        },
        "service": {
          "type": "object",
          "required": ["type", "port", "public"],
          "properties": {
            "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "public": {
              "type": "object",
              "required": ["enabled", "type", "port"],
              "properties": {
                "enabled": {"type": "boolean"},
                "type": {"type": "string", "enum": ["NodePort", "LoadBalancer"]},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        },
        "callContextRedisUrl": {"type": "string"}
      }
    },
    "database": {
      "type": "object",
      "required": ["url", "existingSecret", "secretKey"],
      "properties": {
        "url": {"type": "string"},
        "existingSecret": {"type": "string"},
        "secretKey": {"type": "string", "minLength": 1}
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled", "image", "auth", "service", "persistence"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "auth": {
          "type": "object",
          "required": ["database", "username", "password", "passwordKey"],
          "properties": {
            "database": {"type": "string", "minLength": 1},
            "username": {"type": "string", "minLength": 1},
            "password": {"type": "string"},
            "passwordKey": {"type": "string", "minLength": 1}
          }
        },
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "persistence": {
          "type": "object",
          "required": ["enabled", "size", "storageClass"],
          "properties": {
            "enabled": {"type": "boolean"},
            "size": {"type": "string", "minLength": 1},
            "storageClass": {"type": "string"}
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "required": ["enabled", "image", "service", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "resources": {"type": "object"}
      }
    },
    "observability": {
      "type": "object",
      "required": ["performanceDebug", "tracing", "profiling", "slo", "serviceMonitor", "prometheusRule", "grafanaDashboard"],
      "properties": {
        "performanceDebug": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}
          }
        },
        "tracing": {
          "type": "object",
          "required": ["enabled", "otlpEndpoint", "sampleRatio"],
          "properties": {
            "enabled": {"type": "boolean"},
            "otlpEndpoint": {"type": "string"},
            "sampleRatio": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "profiling": {
          "type": "object",
          "required": ["enabled", "serverAddress", "sampleRate"],
          "properties": {
            "enabled": {"type": "boolean"},
            "serverAddress": {"type": "string"},
            "sampleRate": {"type": "integer", "minimum": 1, "maximum": 1000}
          }
        },
        "slo": {
          "type": "object",
          "required": ["availabilityTarget", "runtimeP90Seconds", "runtimeP95Seconds", "runtimeP99Seconds", "completeCoverageTarget", "burnRateFast", "burnRateSlow", "heartbeatMaxAgeSeconds", "telemetryMaxAgeSeconds", "pipelineMaxAgeSeconds"],
          "properties": {
            "availabilityTarget": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "runtimeP90Seconds": {"type": "number", "exclusiveMinimum": 0},
            "runtimeP95Seconds": {"type": "number", "exclusiveMinimum": 0},
            "runtimeP99Seconds": {"type": "number", "exclusiveMinimum": 0},
            "completeCoverageTarget": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "burnRateFast": {"type": "number", "exclusiveMinimum": 0},
            "burnRateSlow": {"type": "number", "exclusiveMinimum": 0},
            "heartbeatMaxAgeSeconds": {"type": "number", "exclusiveMinimum": 0},
            "telemetryMaxAgeSeconds": {"type": "number", "exclusiveMinimum": 0},
            "pipelineMaxAgeSeconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "serviceMonitor": {
          "type": "object",
          "required": ["enabled", "interval", "scrapeTimeout", "labels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
            "labels": {"type": "object"}
          }
        },
        "prometheusRule": {
          "type": "object",
          "required": ["enabled", "labels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"type": "object"}
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "required": ["enabled", "labels", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"type": "object"},
            "annotations": {"type": "object"}
          }
        }
      }
    },
    "security": {
      "type": "object",
      "required": ["metrics", "bootstrapAdmin", "controlSecret", "runtimeLogs", "artifactSigning", "controlTls"],
      "properties": {
        "metrics": {
          "type": "object",
          "required": ["existingSecret", "tokenKey"],
          "properties": {
            "existingSecret": {"type": "string"},
            "tokenKey": {"type": "string", "minLength": 1}
          }
        },
        "bootstrapAdmin": {
          "type": "object",
          "required": ["existingSecret", "email", "password", "name", "emailKey", "passwordKey", "nameKey"],
          "properties": {
            "existingSecret": {"type": "string"},
            "email": {"type": "string"},
            "password": {"type": "string"},
            "name": {"type": "string", "minLength": 1}
          }
        },
        "controlSecret": {
          "type": "object",
          "required": ["existingSecret", "runnerTokenKey", "betterAuthSecretKey"],
          "properties": {"existingSecret": {"type": "string"}}
        },
        "runtimeLogs": {
          "type": "object",
          "required": ["existingSecret", "encryptionKeyKey"],
          "properties": {
            "existingSecret": {"type": "string"},
            "encryptionKeyKey": {"type": "string", "minLength": 1}
          }
        },
        "artifactSigning": {
          "type": "object",
          "required": ["existingSecret", "privateKey", "publicKey", "privateKeyKey", "publicKeyKey"],
          "properties": {
            "existingSecret": {"type": "string"},
            "privateKey": {"type": "string"},
            "publicKey": {"type": "string"}
          }
        },
        "controlTls": {
          "type": "object",
          "required": ["existingSecret", "autoGenerate", "caKey", "controllerCertificateKey", "controllerPrivateKeyKey", "runnerCertificateKey", "runnerPrivateKeyKey"],
          "properties": {
            "existingSecret": {"type": "string"},
            "autoGenerate": {"type": "boolean"}
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    }
  }
}
