{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "controller",
    "runner",
    "database",
    "postgresql",
    "redis",
    "security"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "rolloutRevision": {
      "type": "string"
    },
    "controller": {
      "type": "object",
      "required": [
        "image",
        "publicUrl"
      ],
      "properties": {
        "publicUrl": {
          "description": "Public URLs. First is the canonical auth base URL; all default to trusted origins. A single string remains supported.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^https?://[^\\s/?#]+([/?#].*)?$"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^https?://[^\\s/?#]+([/?#].*)?$"
              }
            }
          ]
        },
        "trustedOrigins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https?://"
          }
        },
        "auth": {
          "type": "object",
          "required": [],
          "properties": {
            "minPasswordLength": {
              "type": "integer",
              "minimum": 5,
              "maximum": 128
            },
            "allowLocalDefaultCredentials": {
              "type": "boolean"
            }
          }
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "service": {
          "type": "object",
          "required": [],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "public": {
              "type": "object",
              "required": [],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "NodePort",
                    "LoadBalancer"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "required": [
        "image",
        "default",
        "pools",
        "callContextRedisUrl"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "default": {
          "type": "object",
          "required": [
            "replicaCount",
            "maxConcurrency"
          ],
          "properties": {
            "replicaCount": {
              "type": "integer",
              "minimum": 1
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "replicaCount",
              "maxConcurrency",
              "resources"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "replicaCount": {
                "type": "integer",
                "minimum": 1
              },
              "maxConcurrency": {
                "type": "integer",
                "minimum": 1
              },
              "compilerCapable": {
                "type": "boolean"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "required": [],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "public": {
              "type": "object",
              "required": [],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "NodePort",
                    "LoadBalancer"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        },
        "callContextRedisUrl": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "url",
        "existingSecret",
        "secretKey"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "auth",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "auth": {
          "type": "object",
          "required": [
            "database",
            "username",
            "password",
            "passwordKey"
          ],
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string"
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistence": {
          "type": "object",
          "required": [
            "enabled",
            "size",
            "storageClass"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "performanceDebug",
        "tracing",
        "profiling",
        "serviceMonitor",
        "prometheusRule",
        "grafanaDashboard"
      ],
      "properties": {
        "performanceDebug": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "tracing": {
          "type": "object",
          "required": [
            "enabled",
            "otlpEndpoint"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "otlpEndpoint": {
              "type": "string"
            },
            "sampleRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "profiling": {
          "type": "object",
          "required": [
            "enabled",
            "serverAddress"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serverAddress": {
              "type": "string"
            },
            "sampleRate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "slo": {
          "type": "object",
          "required": [],
          "properties": {
            "availabilityTarget": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "runtimeP90Seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "runtimeP95Seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "runtimeP99Seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "completeCoverageTarget": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "burnRateFast": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "burnRateSlow": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heartbeatMaxAgeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "telemetryMaxAgeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pipelineMaxAgeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "required": [
            "enabled",
            "labels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "required": [
            "enabled",
            "labels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "required": [
            "enabled",
            "labels",
            "annotations"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "required": [
        "controlTls",
        "bootstrapAdmin"
      ],
      "properties": {
        "customCa": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "certificateKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "tokenKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "bootstrapAdmin": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "passwordHash": {
              "type": "string",
              "pattern": "^$|^[0-9a-f]{32}:[0-9a-f]{128}$"
            },
            "passwordHashKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "controlSecret": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "runtimeLogs": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "encryptionKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "artifactSigning": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "privateKey": {
              "type": "string"
            },
            "publicKey": {
              "type": "string"
            }
          }
        },
        "controlTls": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "autoGenerate": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            },
            "caPrivateKeyKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "bootstrap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    }
  }
}
