{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "controller",
    "runner",
    "database",
    "postgresql",
    "redis",
    "security"
  ],
  "properties": {
    "publicUrl": {
      "description": "Shared external HTTP(S) origin for UI, Endpoint addresses and Better Auth. Empty preserves legacy per-component URLs; internal calls always use Service DNS. No path, credentials, query or fragment.",
      "type": "string",
      "pattern": "^(https?://[^/?#@\\s]+/?)?$"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "rolloutRevision": {
      "type": "string"
    },
    "controller": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "publicUrl": {
          "description": "Legacy UI-only URLs, used when top-level publicUrl is empty. First is the auth base URL; all derive trusted origins and Ingress hosts.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^https?://[^\\s/?#]+([/?#].*)?$"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^https?://[^\\s/?#]+([/?#].*)?$"
              }
            }
          ]
        },
        "trustedOrigins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https?://"
          },
          "description": "Optional browser origins. Shared publicUrl is always trusted; without a shared URL, this replaces the derived legacy origins."
        },
        "auth": {
          "type": "object",
          "properties": {
            "minLoginLength": {
              "type": "integer",
              "minimum": 5,
              "maximum": 128
            }
          },
          "additionalProperties": false
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "resources": {
          "type": "object"
        },
        "endpointContextStorage": {
          "type": "object",
          "required": [
            "maxRowsPerPool",
            "maxRowsGlobal",
            "maxPayloadBytesPerContext",
            "maxPayloadBytesPerPool",
            "maxPayloadBytesGlobal"
          ],
          "properties": {
            "maxRowsPerPool": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxRowsGlobal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "maxPayloadBytesPerContext": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxPayloadBytesPerPool": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxPayloadBytesGlobal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "required": [
        "image",
        "default",
        "pools",
        "callContextRedisUrl"
      ],
      "properties": {
        "publicUrl": {
          "description": "Optional different external data-plane HTTP(S) base URL. Empty inherits top-level publicUrl, or the incoming Controller request origin when neither is set. Internal calls always use Service DNS. No credentials, query, fragment or Endpoint suffix.",
          "type": "string",
          "pattern": "^(https?://[^/?#@\\s]+(/[^?#\\s]*)?)?$"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "default": {
          "type": "object",
          "required": [
            "replicaCount",
            "maxConcurrency"
          ],
          "properties": {
            "replicaCount": {
              "type": "integer",
              "minimum": 1
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "type": "object"
            },
            "tenantAdmission": {
              "$ref": "#/definitions/tenantAdmission"
            },
            "distributedRateAdmission": {
              "$ref": "#/definitions/distributedRateAdmission"
            },
            "groupRateAdmission": {
              "$ref": "#/definitions/groupRateAdmission"
            }
          },
          "additionalProperties": false
        },
        "pools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "replicaCount",
              "maxConcurrency",
              "resources"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "replicaCount": {
                "type": "integer",
                "minimum": 1
              },
              "maxConcurrency": {
                "type": "integer",
                "minimum": 1
              },
              "compilerCapable": {
                "type": "boolean"
              },
              "resources": {
                "type": "object"
              },
              "tenantAdmission": {
                "$ref": "#/definitions/tenantAdmission"
              },
              "distributedRateAdmission": {
                "$ref": "#/definitions/distributedRateAdmission"
              },
              "groupRateAdmission": {
                "$ref": "#/definitions/groupRateAdmission"
              }
            },
            "additionalProperties": false
          }
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "callContextRedisUrl": {
          "type": "string"
        },
        "state": {
          "type": "object",
          "properties": {
            "sizeLimit": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "telemetryProgress": {
          "type": "object",
          "required": [
            "persistence"
          ],
          "properties": {
            "persistence": {
              "type": "object",
              "required": [
                "enabled",
                "size",
                "storageClass"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "size": {
                  "type": "string",
                  "description": "Per-replica telemetry progress PVC capacity, separate from the artifact cache.",
                  "pattern": "^[1-9][0-9]{0,5}(Mi|Gi)$"
                },
                "storageClass": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": [
        "existingSecret",
        "secretKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "postgresql": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "auth",
        "persistence"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "auth": {
          "type": "object",
          "required": [
            "database",
            "username"
          ],
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "credentialKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "required": [
            "enabled",
            "size",
            "storageClass"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "redis": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "required": [
        "performanceDebug",
        "tracing",
        "profiling",
        "serviceMonitor",
        "prometheusRule",
        "grafanaDashboard"
      ],
      "properties": {
        "performanceDebug": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "tracing": {
          "type": "object",
          "required": [
            "enabled",
            "otlpEndpoint"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "otlpEndpoint": {
              "type": "string"
            },
            "sampleRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "profiling": {
          "type": "object",
          "required": [
            "enabled",
            "serverAddress"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serverAddress": {
              "type": "string"
            },
            "sampleRate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        "slo": {
          "type": "object",
          "properties": {
            "availabilityTarget": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "runtimeP95Seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "runtimeP99Seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "completeCoverageTarget": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "burnRateFast": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "burnRateSlow": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heartbeatMaxAgeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "telemetryMaxAgeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pipelineMaxAgeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "serviceMonitor": {
          "type": "object",
          "required": [
            "enabled",
            "labels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "labels": {
              "description": "Extra metadata labels shared by Controller and Runner ServiceMonitors. String values add labels; null removes a default label. Chart-generated label keys are reserved.",
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "prometheusRule": {
          "type": "object",
          "required": [
            "enabled",
            "labels"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            }
          },
          "additionalProperties": false
        },
        "grafanaDashboard": {
          "type": "object",
          "required": [
            "enabled",
            "labels",
            "annotations"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "controlTls",
        "bootstrapAdmin"
      ],
      "properties": {
        "customCa": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "certificateKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "tokenKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "bootstrapAdmin": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "localDefault": {
              "type": "boolean"
            },
            "credentialKey": {
              "type": "string"
            },
            "digestKey": {
              "type": "string"
            },
            "emailKey": {
              "type": "string"
            },
            "nameKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "controlSecret": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "runnerTokenKey": {
              "type": "string",
              "minLength": 1
            },
            "betterAuthSecretKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "poolAuthentication": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "scopedTelemetry": {
              "type": "boolean"
            },
            "telemetryProgress": {
              "type": "boolean"
            },
            "controllerSecret": {
              "type": "string"
            },
            "controllerKey": {
              "type": "string",
              "minLength": 1
            },
            "runnerSecrets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "runnerHttpAuthentication": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "controllerSecret": {
              "type": "string"
            },
            "controllerKey": {
              "type": "string",
              "minLength": 1
            },
            "runnerSecrets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "name",
                  "key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "runtimeLogs": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "encryptionKeyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "artifactSigning": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "privateKeyKey": {
              "type": "string",
              "minLength": 1
            },
            "publicKeyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "controlTls": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "autoGenerate": {
              "type": "boolean"
            },
            "enabled": {
              "type": "boolean"
            },
            "caPrivateKeyKey": {
              "type": "string",
              "minLength": 1
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            },
            "controllerCertificateKey": {
              "type": "string",
              "minLength": 1
            },
            "controllerPrivateKeyKey": {
              "type": "string",
              "minLength": 1
            },
            "runnerCertificateKey": {
              "type": "string",
              "minLength": 1
            },
            "runnerPrivateKeyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "bootstrap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "bootstrapUser": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "emailKey": {
              "type": "string"
            },
            "nameKey": {
              "type": "string"
            },
            "localDefault": {
              "type": "boolean"
            },
            "credentialKey": {
              "type": "string"
            },
            "digestKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "runnerIsolation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ingressPeers": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/networkPolicyPeer"
              }
            },
            "dnsPeers": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/networkPolicyPeer"
              }
            },
            "poolEgress": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "to",
                    "ports"
                  ],
                  "properties": {
                    "to": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/networkPolicyPeer"
                      },
                      "minItems": 1
                    },
                    "ports": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "port",
                          "protocol"
                        ],
                        "properties": {
                          "port": {
                            "oneOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 65535
                              },
                              {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "^[a-z0-9][a-z0-9-]*$",
                                "maxLength": 15
                              }
                            ]
                          },
                          "protocol": {
                            "enum": [
                              "TCP",
                              "UDP",
                              "SCTP"
                            ]
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "public": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "properties": {
        "podSelector": {
          "type": "object",
          "properties": {
            "matchLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "matchExpressions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "operator"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operator": {
                    "enum": [
                      "In",
                      "NotIn",
                      "Exists",
                      "DoesNotExist"
                    ]
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "namespaceSelector": {
          "type": "object",
          "properties": {
            "matchLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "matchExpressions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "operator"
