        "id": "cn-prompt-security/instruction-override",
        "name": "Chinese instruction override",
        "description": "Rejects selected explicit Chinese phrases that ask the model to ignore, override, or bypass trusted instructions. It does not detect arbitrary paraphrases or establish instruction trust.",
        "detector": {
          "ref": "text/regex",
          "version": "1.0.0"
