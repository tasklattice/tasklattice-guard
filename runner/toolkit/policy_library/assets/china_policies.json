        "id": "cn-prompt-security/prompt-extraction",
        "name": "Chinese prompt extraction request",
        "description": "Rejects selected explicit Chinese requests to reveal or reproduce protected system or developer instructions. It does not prevent every disclosure path.",
        "detector": {
          "ref": "text/regex",
