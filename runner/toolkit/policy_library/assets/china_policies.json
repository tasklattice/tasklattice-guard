    "rules": [
      {
        "id": "cn-business-identifier/unified-social-credit-code",
        "name": "Contextual Unified Social Credit Code",
        "description": "Redacts an 18-character candidate only when a nearby Chinese label is present and the GB 32100 checksum is valid. It does not verify registration or organization status.",
        "detector": {
          "ref": "text/regex",
          "version": "1.0.0"
        },
        "effect": "redact",
        "risk_severity": "low",
        "rails": [
          "input",
          "output"
        ],
        "implementation": {
          "engine": "nemo-guardrails",
          "detector": "regex",
          "flow_name": null,
          "action_name": "GuardContentFilterAction",
          "execution": "local",
          "binding_id": "china-organization-identifiers",
          "implementation_rule_id": "cn-business-identifier/unified-social-credit-code"
        },
        "expression": "(?<![0-9A-Z])[159Y][1239][0-9ABCDEFGHJKLMNPQRTUWXY]{16}(?![0-9A-Z])",
        "context_expression": "(?:统一社会信用代码|社会信用代码|统一信用代码)",
        "context_max_gap_words": 3,
        "validators": [
          {
            "type": "weighted_checksum",
            "alphabet": "0123456789ABCDEFGHJKLMNPQRTUWXY",
            "weights": [
              1,
              3,
              9,
              27,
              19,
              26,
              16,
              17,
              20,
              29,
              25,
              13,
              8,
              24,
              10,
              30,
              28
            ],
            "check_characters": "0YXWUTRQPNMLKJHGFEDCBA987654321"
          }
        ],
        "taxonomy_ids": [
          "TALI-BUSINESS-POLICY"
        ],
        "redaction": "[cn_uscc_REDACTED]"
      }
    ]
  },
