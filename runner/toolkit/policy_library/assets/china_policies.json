    "rules": [
      {
        "id": "cn-personal-information/resident-identity-card",
        "name": "PRC resident identity card number",
        "description": "Redacts 18-character resident identity card candidates only after birth-date and MOD 11-2 checksum validation. It does not verify issuance, holder identity, or the six-digit administrative division code.",
        "detector": {
          "ref": "text/regex",
          "version": "1.0.0"
        },
        "effect": "redact",
        "risk_severity": "medium",
        "rails": [
          "input",
          "output"
        ],
        "implementation": {
          "engine": "nemo-guardrails",
          "detector": "regex",
          "flow_name": null,
          "action_name": "GuardContentFilterAction",
          "execution": "local",
          "binding_id": "china-personal-identifiers",
          "implementation_rule_id": "cn-personal-information/resident-identity-card"
        },
        "expression": "(?<![0-9])[1-9][0-9]{5}(?:18|19|20)[0-9]{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])[0-9]{3}[0-9Xx](?![0-9])",
        "validators": [
          {
            "type": "date",
            "start": 6,
            "format": "YYYYMMDD"
          },
          {
            "type": "weighted_checksum",
            "alphabet": "0123456789",
            "weights": [
              7,
              9,
              10,
              5,
              8,
              4,
              2,
              1,
              6,
              3,
              7,
              9,
              10,
              5,
              8,
              4,
              2
            ],
            "check_characters": "10X98765432"
          }
        ],
        "taxonomy_ids": [
          "TALI-PRIVACY-PII"
        ],
        "redaction": "[cn_resident_id_REDACTED]"
      },
      {
        "id": "cn-personal-information/mainland-mobile",
        "name": "China mainland mobile number",
        "description": "Redacts standalone +86/86-prefixed or domestic 11-digit mobile-number patterns. It does not verify allocation, ownership, or whether a number identifies a person in context.",
        "detector": {
          "ref": "text/regex",
          "version": "1.0.0"
        },
        "effect": "redact",
        "risk_severity": "medium",
        "rails": [
          "input",
          "output"
        ],
        "implementation": {
          "engine": "nemo-guardrails",
          "detector": "regex",
          "flow_name": null,
          "action_name": "GuardContentFilterAction",
          "execution": "local",
          "binding_id": "china-personal-identifiers",
          "implementation_rule_id": "cn-personal-information/mainland-mobile"
        },
        "expression": "(?<![0-9])(?:\\+?86[\\s-]?)?1[3-9][0-9]{9}(?![0-9])",
        "taxonomy_ids": [
          "TALI-PRIVACY-PII"
        ],
        "redaction": "[cn_mobile_REDACTED]"
      },
      {
        "id": "cn-personal-information/unionpay-card",
        "name": "Contextual UnionPay card number",
        "description": "Redacts labelled 16–19 digit 62-prefixed card candidates that pass a Luhn check. It does not identify every Chinese bank account, establish ownership, or validate account status.",
        "detector": {
          "ref": "text/regex",
          "version": "1.0.0"
        },
        "effect": "redact",
        "risk_severity": "high",
        "rails": [
          "input",
          "output"
        ],
        "implementation": {
          "engine": "nemo-guardrails",
          "detector": "regex",
          "flow_name": null,
          "action_name": "GuardContentFilterAction",
          "execution": "local",
          "binding_id": "china-personal-identifiers",
          "implementation_rule_id": "cn-personal-information/unionpay-card"
        },
        "expression": "(?<![0-9])62(?:[\\s-]?[0-9]){14,17}(?![0-9])",
        "context_expression": "(?i)(?:银行卡(?:号)?|卡号|借记卡|信用卡|bank\\s*card|card\\s*(?:number|no\\.?))",
        "context_max_gap_words": 4,
        "validators": [
          {
            "type": "luhn"
          }
        ],
        "taxonomy_ids": [
          "TALI-PRIVACY-FINANCIAL"
        ],
        "redaction": "[cn_bank_card_REDACTED]"
      }
    ]
  },
