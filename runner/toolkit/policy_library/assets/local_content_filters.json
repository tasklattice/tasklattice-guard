[
  {
    "id": "block-code-execution",
    "name": "Block Code Execution",
    "description": "Detects executable fenced code and explicit execution requests while allowing explanation and review intent.",
    "source": "built_in",
    "version": "1.0.0",
    "tags": [
      {
        "namespace": "protection",
        "value": "application_injection",
        "label": "Code & application injection",
        "source": "declared"
      },
      {
        "namespace": "collection",
        "value": "local-content-filter",
        "label": "Local Content Filter",
        "source": "declared"
      },
      {
        "namespace": "guardrail_category",
        "value": "tool_calling",
        "label": "Tool Calling",
        "source": "declared"
      },
      {
        "namespace": "implementation",
        "value": "code-block",
        "label": "Code Block",
        "source": "derived"
      },
      {
        "namespace": "rail",
        "value": "input",
        "label": "Input rail",
        "source": "derived"
      },
      {
        "namespace": "rail",
        "value": "output",
        "label": "Output rail",
        "source": "derived"
      }
    ],
    "safety_level": "strict",
    "output_delivery": "full_buffered",
    "parameters": [
      {
        "name": "blocked_languages",
        "label": "Blocked languages",
        "kind": "textarea",
        "required": false,
        "placeholder": "Blank for all, or one language per line",
        "description": "Language aliases such as py, js, sh, and ts are normalized."
      },
      {
        "name": "confidence_threshold",
        "label": "Confidence threshold",
        "kind": "text",
        "required": false,
        "placeholder": "0.5",
        "description": "A value from 0 to 1; blank uses 0.5."
      },
      {
        "name": "detect_execution_intent",
        "label": "Require execution intent on input",
        "kind": "text",
        "required": false,
        "placeholder": "true",
        "description": "Blank defaults to true. Output code is always enforced."
      }
    ],
    "test_cases": [
      {
        "id": "accept/code-execution",
        "name": "Block an executable Python request",
        "description": "Required acceptance case for executable fenced code.",
        "phase": "input",
        "content": "Please run this code:\n```python\nprint('hello')\n```",
        "expected_decision": "block",
        "covered_rule_ids": [
          "code/execution"
        ],
        "kind": "rule_acceptance",
        "required": true,
        "parameter_names": [],
        "group": "Rule acceptance"
      },
      {
        "id": "accept/code-execution/output",
        "name": "Block an executable Python request",
        "description": "Required acceptance case for executable fenced code.",
        "phase": "output",
        "content": "Please run this code:\n```python\nprint('hello')\n```",
        "expected_decision": "block",
        "covered_rule_ids": [
          "code/execution"
        ],
        "kind": "rule_acceptance",
        "required": true,
        "parameter_names": [],
        "group": "Rule acceptance"
      },
      {
        "id": "accept/explicit-execution",
        "name": "Block an explicit execution request",
        "description": "A plain execution request is detected independently of its handling action.",
        "phase": "input",
        "content": "Please run the tests",
        "expected_decision": "block",
        "covered_rule_ids": [
          "code/execution-request"
        ],
        "kind": "rule_acceptance"
      }
    ],
    "rules": [
      {
        "id": "code/execution",
        "name": "Executable code and execution intent",
        "description": "Detects fenced executable code and explicit requests to execute commands.",
        "detector": {
          "ref": "code/fenced-block",
          "version": "1.0.0"
        },
        "effect": "block",
        "risk_severity": "high",
        "rails": [
          "input",
          "output"
        ],
        "implementation": {
          "engine": "nemo-guardrails",
          "detector": "code_block",
          "flow_name": null,
          "action_name": "GuardContentFilterAction",
          "execution": "local",
          "binding_id": "block-code-execution",
          "implementation_rule_id": "execution"
        },
        "detector_options": {
          "require_terms": [
            "run this ",
            "run these ",
            "execute this ",
            "please run ",
            "can you run ",
            "run `",
            "execute `",
            "run code",
            "run the snippet",
            "execute the command",
            "just run it",
            "compile and run",
            "run the program",
            "run the tests",
            "check if tests pass",
            "read /",
            "list the files",
            "create a file",
            "run curl",
            "make an http request",
            "connect to postgres",
            "paste the output",
            "tell me the result"
          ],
          "exclude_terms": [
            "don't run",
            "do not run",
            "don't execute",
            "do not execute",
            "no execution",
            "without running",
            "just reason",
            "what would happen if",
            "what would this output",
            "explain what this code",
            "explain what this script",
            "can you explain this code",
            "refactor this code",
            "convert this code",
            "spot any security issues",
            "write pseudocode"
          ],
          "languages": "{{blocked_languages}}",
          "minimum_score": "{{confidence_threshold}}",
          "require_context": "{{detect_execution_intent}}"
        },
        "taxonomy_ids": [
          "TALI-TOOL-SECURITY-UNAUTHORIZED-EXECUTION"
        ],
        "redaction": "[CODE_BLOCK_REDACTED]"
      },
      {
        "id": "code/execution-request",
        "name": "Explicit execution request",
        "description": "Detect a request to execute commands, even without a fenced code block.",
        "detector": {
          "ref": "text/conditions",
          "version": "1.0.0"
        },
        "effect": "block",
        "risk_severity": "high",
        "rails": [
          "input"
        ],
        "implementation": {
          "engine": "nemo-guardrails",
          "detector": "conditions",
          "flow_name": null,
          "action_name": "GuardContentFilterAction",
          "execution": "local",
          "binding_id": "block-code-execution",
          "implementation_rule_id": "code/execution-request"
        },
        "detector_options": {
          "match": {
            "all": [
              {
                "parameter_in": {
                  "name": "detect_execution_intent",
                  "values": [
                    "true",
                    "1",
                    "yes",
                    "on"
                  ],
                  "default": "true"
                }
              },
              {
                "contains": [
                  "run this ",
                  "run these ",
                  "execute this ",
                  "please run ",
                  "can you run ",
                  "run `",
                  "execute `",
                  "run code",
                  "run the snippet",
                  "execute the command",
                  "just run it",
                  "compile and run",
                  "run the program",
                  "run the tests",
                  "check if tests pass",
                  "read /",
                  "list the files",
                  "create a file",
                  "run curl",
                  "make an http request",
                  "connect to postgres",
                  "paste the output",
