# Guard Controller
NODE_ENV=development
CONTROLLER_HTTP_HOST=0.0.0.0
CONTROLLER_HTTP_PORT=8080
CONTROLLER_GRPC_HOST=0.0.0.0
CONTROLLER_GRPC_PORT=9090
CONTROLLER_DATABASE_URL=postgresql://guard:guard@localhost:5432/guard
CONTROLLER_PUBLIC_URL=http://localhost:8080
# Internal Controller-to-Runner address. Helm injects canonical in-cluster DNS.
CONTROLLER_RUNTIME_SERVICE_URL=http://localhost:8091
# Optional external base URL advertised in Endpoint setup (e.g. https://guard.example.com:8443).
# Leave empty to derive the origin from the incoming Controller request. Do not include /runtime/v1/endpoints or an Endpoint UUID.
CONTROLLER_RUNTIME_PUBLIC_URL=
CONTROLLER_UI_DIST=dist
CONTROLLER_POLICY_CATALOG_DIR=../runner/toolkit/policy_library/assets
CONTROLLER_PROTO_PATH=../proto/tasklattice/guard/control/v1/runner_control.proto
CONTROLLER_MIGRATIONS_PATH=server/db/migrations
# Filled by npm run dev:setup. Each JSON map contains credentials keyed by Pool ID.
CONTROLLER_RUNNER_POOL_TOKENS_JSON=replace-with-pool-control-token-map
CONTROLLER_RUNNER_HTTP_TOKENS_JSON=replace-with-pool-http-token-map
# Optional outside Helm; when set, /metrics requires this dedicated Bearer token.
CONTROLLER_METRICS_TOKEN=replace-with-a-different-32-character-metrics-token
# Filled by npm run dev:setup; never commit generated private keys.
CONTROLLER_ARTIFACT_SIGNING_KEY_PATH=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8092
# Optional corporate OIDC SSO. Use a dedicated Guard client in the same
# Keycloak realm as Relay; never reuse Relay's client secret.
CONTROLLER_SSO_ENABLED=false
# CONTROLLER_SSO_ISSUER=https://identity.example.com/realms/company
# CONTROLLER_SSO_CLIENT_ID=tasklattice-guard
# CONTROLLER_SSO_CLIENT_SECRET=inject-through-a-secret
# CONTROLLER_SSO_DISPLAY_NAME=Company SSO
# Keycloak full Group Path claim, e.g. /tali/d/dep1/p/project1/r/ROLE_PROJECT_ADMIN
# CONTROLLER_SSO_GROUP_CLAIM=groups
# Optional comma-separated exact verified email domains.
# CONTROLLER_SSO_ALLOWED_EMAIL_DOMAINS=example.com
# Controller initialization overwrites these accounts with these credentials.
BETTER_AUTH_MIN_PASSWORD_LENGTH=8
CONTROLLER_BOOTSTRAP_ADMIN_USERNAME=admin
CONTROLLER_BOOTSTRAP_ADMIN_PASSWORD=password
CONTROLLER_BOOTSTRAP_USER_USERNAME=user
CONTROLLER_BOOTSTRAP_USER_PASSWORD=password
CONTROLLER_BOOTSTRAP_USER_PROJECT=test1
RUNNER_HEARTBEAT_INTERVAL_SECONDS=10
RUNNER_OFFLINE_AFTER_SECONDS=30
DELETE_TRAFFIC_WINDOW_MINUTES=30
TELEMETRY_STALE_AFTER_SECONDS=60

# Model Providers, credentials, Models, control-plane/data-plane assignments,
# validation, activation, and rollback are configured after sign-in under
# Settings → Models. PostgreSQL is the source of truth; Runner receives only a
# typed active revision and short-lived in-memory credential resolution.
#
# The legacy MODEL_GUARDRAILS_* model environment variables remain supported
# as a non-blocking upgrade fallback, but new deployments do not need them.

# Production Controller-to-Runner mTLS (all three must be set together).
# CONTROLLER_GRPC_TLS_CERT_PATH=/path/to/controller.crt
# CONTROLLER_GRPC_TLS_KEY_PATH=/path/to/controller.key
# CONTROLLER_GRPC_TLS_CLIENT_CA_PATH=/path/to/ca.crt

# Guard Runner
GUARD_RUNNER_ID=runner-default-0
# Dedicated pools use their immutable, canonical Project name. The final index
# identifies a replica, e.g. runner-support-search-0, runner-support-search-1.
GUARD_RUNNER_PROJECT_NAME=default
GUARD_RUNNER_POOL_ID=default
GUARD_RUNNER_COMPILER_CAPABLE=true
GUARD_RUNNER_MAX_CONCURRENCY=64
GUARD_CONTROLLER_TARGET=localhost:9090
# The Pool's control token is used for gRPC and outbound HTTP to the Controller.
GUARD_RUNNER_CONTROL_TOKEN=replace-with-default-pool-control-token
# Separate token for Controller-to-Runner HTTP requests.
GUARD_CONTROLLER_HTTP_TOKEN=replace-with-default-pool-http-token
# Use the same dedicated value as CONTROLLER_METRICS_TOKEN for one Prometheus job.
GUARD_METRICS_TOKEN=replace-with-a-different-32-character-metrics-token
GUARD_CONTROLLER_TELEMETRY_ENDPOINT=http://localhost:8080/api/internal/v1/runtime-events
GUARD_ARTIFACT_PUBLIC_KEY_PATH=
GUARD_RUNNER_STATE_PATH=/tmp/tasklattice-guard-runner
GUARD_RUNNER_TELEMETRY_BATCH_SIZE=100

# Required for horizontal Runner replicas so input/output checks pin the same
# Guardrail version across Pods.
# GUARD_RUNNER_CALL_CONTEXT_REDIS_URL=redis://localhost:6379/0
# Enable only after every Runner sharing Redis supports compressed plan reads.
# GUARD_RUNNER_CALL_CONTEXT_COMPRESS_PLANS=true
# Current-content checks continue without shared history only on Redis capacity exhaustion.
# GUARD_RUNNER_CALL_CONTEXT_CAPACITY_FALLBACK=true
# GUARD_RUNNER_CALL_CONTEXT_TTL_SECONDS=300

# Production Runner-to-Controller mTLS (all three must be set together).
# GUARD_CONTROLLER_CA_PATH=/path/to/ca.crt
# GUARD_RUNNER_CLIENT_CERT_PATH=/path/to/runner.crt
# GUARD_RUNNER_CLIENT_KEY_PATH=/path/to/runner.key
