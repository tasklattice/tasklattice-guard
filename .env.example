# Guard Controller
NODE_ENV=development
CONTROLLER_HTTP_HOST=0.0.0.0
CONTROLLER_HTTP_PORT=8080
CONTROLLER_GRPC_HOST=0.0.0.0
CONTROLLER_GRPC_PORT=9090
CONTROLLER_DATABASE_URL=postgresql://guard:guard@localhost:5432/guard
CONTROLLER_PUBLIC_URL=http://localhost:8080
# Stable Runtime Service origin used in Integration setup instructions for
# standalone local development. Helm injects the canonical in-cluster DNS.
CONTROLLER_RUNTIME_SERVICE_URL=http://localhost:8091
CONTROLLER_UI_DIST=dist
CONTROLLER_POLICY_CATALOG_DIR=../runner/toolkit/policy_library/assets
CONTROLLER_PROTO_PATH=../proto/tasklattice/guard/control/v1/runner_control.proto
CONTROLLER_MIGRATIONS_PATH=server/db/migrations
CONTROLLER_RUNNER_TOKEN=replace-with-at-least-32-random-characters
# Optional outside Helm; when set, /metrics requires this dedicated Bearer token.
CONTROLLER_METRICS_TOKEN=replace-with-a-different-32-character-metrics-token
CONTROLLER_ARTIFACT_SIGNING_KEY_PATH=/tmp/guard-private.pem
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8092
# Local-only baseline: sign in as admin/admin; Better Auth stores the internal
# identity as admin@tasklattice.local. Production uses min length 12 and a strong
# externally managed bootstrap Secret.
BETTER_AUTH_MIN_PASSWORD_LENGTH=12
CONTROLLER_ALLOW_LOCAL_DEFAULT_CREDENTIALS=true
CONTROLLER_BOOTSTRAP_ADMIN_EMAIL=admin@tasklattice.local
CONTROLLER_BOOTSTRAP_ADMIN_PASSWORD=admin
CONTROLLER_BOOTSTRAP_ADMIN_NAME=Local Administrator
RUNNER_HEARTBEAT_INTERVAL_SECONDS=10
RUNNER_OFFLINE_AFTER_SECONDS=30
DELETE_TRAFFIC_WINDOW_MINUTES=30
TELEMETRY_STALE_AFTER_SECONDS=60

# Non-secret model routing metadata. The Controller exposes these selected
# providers/models in the global runtime menu so operators can verify the
# control-plane/data-plane boundary at a glance.
MODEL_GUARDRAILS_CONTROL_PLANE_AI_PROVIDER=Qwen
MODEL_GUARDRAILS_CONTROL_PLANE_AI_MODEL=Qwen/Qwen3.5-9B
# The Controller uses this OpenAI-compatible endpoint only while authoring a
# Guardrail. `make helm-install` automatically creates/updates a Kubernetes
# Secret when QWEN_CONTROL_API_KEY is present in the local .env file.
MODEL_GUARDRAILS_CONTROL_PLANE_AI_BASE_URL=http://qwen-control.models.svc.cluster.local/v1
# QWEN_CONTROL_API_KEY=replace-me
# Alternatively, set the Controller contract directly:
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_API_KEY=replace-me
# Optional dedicated Playground model. When omitted, Playground reuses the
# configured Controller model above.
# MODEL_GUARDRAILS_PLAYGROUND_CHAT_BASE_URL=http://qwen-control.models.svc.cluster.local/v1
# MODEL_GUARDRAILS_PLAYGROUND_CHAT_MODEL=Qwen/Qwen3.5-9B
# MODEL_GUARDRAILS_PLAYGROUND_CHAT_API_KEY=replace-me
# Physical endpoints are reusable Model Runtimes. They do not advertise
# Guardrail capabilities.
MODEL_GUARDRAILS_MODEL_RUNTIMES_JSON=[{"id":"qwen3guard","client":"openai_chat","base_url":"http://qwen3guard.models.svc.cluster.local/v1","model":"Qwen/Qwen3Guard-Gen-8B","api_key_env_var":"QWEN_GUARD_API_KEY","timeout_seconds":20,"max_tokens":128},{"id":"llama-guard","client":"openai_chat","base_url":"http://llama-guard.models.svc.cluster.local/v1","model":"meta-llama/Llama-Guard-3-8B","api_key_env_var":"LLAMA_GUARD_API_KEY","timeout_seconds":20,"max_tokens":128},{"id":"qwen-judge","client":"openai_chat","base_url":"http://qwen-control.models.svc.cluster.local/v1","model":"Qwen/Qwen3.5-9B","api_key_env_var":"QWEN_CONTROL_API_KEY","timeout_seconds":30,"max_tokens":256}]
# Bind stable Evaluation Contracts and parsing Profiles to those runtimes.
# Qwen3Guard is primary; Llama Guard is fallback only for the compatible
# content-safety contract.
MODEL_GUARDRAILS_EVALUATOR_BINDINGS_JSON=[{"id":"qwen-content","contract_ref":"tali.guard.content-safety.v1","profile_ref":"tali.qwen3guard.v1","model_ref":"qwen3guard","priority":10},{"id":"qwen-jailbreak","contract_ref":"tali.guard.jailbreak.v1","profile_ref":"tali.qwen3guard.v1","model_ref":"qwen3guard","priority":10},{"id":"qwen-pii","contract_ref":"tali.guard.pii.semantic.v1","profile_ref":"tali.qwen3guard.v1","model_ref":"qwen3guard","priority":10},{"id":"llama-content","contract_ref":"tali.guard.content-safety.v1","profile_ref":"tali.llama-guard-3.v1","model_ref":"llama-guard","priority":20},{"id":"judge-taxonomy","contract_ref":"tali.guard.taxonomy-normalization.v1","profile_ref":"tali.taxonomy-judge.v1","model_ref":"qwen-judge","priority":10},{"id":"judge-topic","contract_ref":"tali.guard.topic-control.semantic.v1","profile_ref":"tali.taxonomy-judge.v1","model_ref":"qwen-judge","priority":10},{"id":"judge-company","contract_ref":"tali.guard.company-policy.v1","profile_ref":"tali.taxonomy-judge.v1","model_ref":"qwen-judge","priority":10}]
# QWEN_GUARD_API_KEY=replace-me
# LLAMA_GUARD_API_KEY=replace-me
# Optional specialized evaluators used by corresponding Policies.
# MODEL_GUARDRAILS_AUTOMATED_REASONING_ENDPOINT_URL=https://reasoning.example.com/v1/evaluate
# MODEL_GUARDRAILS_AUTOMATED_REASONING_API_KEY=replace-me
# `make helm-install` injects the Model Runtime credential variables above into Runner.

# Production Controller-to-Runner mTLS (all three must be set together).
# CONTROLLER_GRPC_TLS_CERT_PATH=/path/to/controller.crt
# CONTROLLER_GRPC_TLS_KEY_PATH=/path/to/controller.key
# CONTROLLER_GRPC_TLS_CLIENT_CA_PATH=/path/to/ca.crt

# Guard Runner
GUARD_RUNNER_ID=local-default-1
GUARD_RUNNER_POOL_ID=default
GUARD_RUNNER_COMPILER_CAPABLE=true
GUARD_RUNNER_MAX_CONCURRENCY=64
GUARD_CONTROLLER_TARGET=localhost:9090
GUARD_CONTROLLER_TOKEN=replace-with-the-same-controller-runner-token
# Use the same dedicated value as CONTROLLER_METRICS_TOKEN for one Prometheus job.
GUARD_METRICS_TOKEN=replace-with-a-different-32-character-metrics-token
GUARD_CONTROLLER_TELEMETRY_ENDPOINT=http://localhost:8080/api/internal/v1/runtime-events
GUARD_ARTIFACT_PUBLIC_KEY_PATH=/tmp/guard-public.pem
GUARD_RUNNER_STATE_PATH=/tmp/tasklattice-guard-runner
GUARD_RUNNER_TELEMETRY_BATCH_SIZE=100

# Required for horizontal Runner replicas so input/output checks pin the same
# Guardrail version across Pods.
# GUARD_RUNNER_CALL_CONTEXT_REDIS_URL=redis://localhost:6379/0

# Production Runner-to-Controller mTLS (all three must be set together).
# GUARD_CONTROLLER_CA_PATH=/path/to/ca.crt
# GUARD_RUNNER_CLIENT_CERT_PATH=/path/to/runner.crt
# GUARD_RUNNER_CLIENT_KEY_PATH=/path/to/runner.key
