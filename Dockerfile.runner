# Use the BuildKit-bundled Dockerfile frontend so local installation does not
# require a separate docker.io/docker/dockerfile pull before cached inputs work.
ARG PYTHON_VERSION=3.13
ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS guardctl-build
WORKDIR /build/controller
COPY --link controller/package.json controller/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci --no-audit --no-fund
COPY --link controller/src/cli ./src/cli
COPY --link controller/tsconfig.cli.json ./
COPY --link controller/scripts/build-guardctl.mjs ./scripts/
RUN npm run build:cli

FROM python:${PYTHON_VERSION}-slim-bookworm AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/
ENV UV_LINK_MODE=copy UV_NO_DEV=1 UV_PROJECT_ENVIRONMENT=/opt/tasklattice/venv UV_PYTHON_DOWNLOADS=0
WORKDIR /build
COPY --link pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked uv sync --locked --no-install-project

FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime
ENV PATH="/opt/tasklattice/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GUARD_RUNNER_STATE_PATH=/var/lib/tasklattice/guard-runner
WORKDIR /opt/tasklattice/guard-runner
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --no-create-home runner \
    && mkdir -p /var/lib/tasklattice/guard-runner \
    && chown -R 65532:65532 /var/lib/tasklattice/guard-runner
COPY --link --from=dependencies /opt/tasklattice/venv /opt/tasklattice/venv
# Runner contains the complete data plane: runtime host, NeMo toolkit, policy
# materialization, and the Default Runner compiler. Only the bundled management
# CLI is included; the Controller server, UI and node_modules stay out.
COPY --link --from=guardctl-build /usr/local/bin/node /usr/local/bin/node
COPY --link --from=guardctl-build /usr/local/LICENSE /usr/local/share/licenses/guardctl/NODE_LICENSE
COPY --link --chmod=0555 --from=guardctl-build /build/controller/dist-cli/guardctl.cjs /usr/local/bin/guardctl
COPY --link --from=guardctl-build /build/controller/dist-cli/THIRD_PARTY_LICENSES.txt /usr/local/share/licenses/guardctl/THIRD_PARTY_LICENSES.txt
COPY --link runner ./runner
ARG TALI_BUILD_INFO
ENV TALI_BUILD_INFO=${TALI_BUILD_INFO}
USER 65532:65532
EXPOSE 8091
VOLUME ["/var/lib/tasklattice/guard-runner"]
CMD ["uvicorn", "runner.main:app", "--host", "0.0.0.0", "--port", "8091"]
