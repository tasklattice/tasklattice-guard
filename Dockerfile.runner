# Use the BuildKit-bundled Dockerfile frontend so local installation does not
# require a separate docker.io/docker/dockerfile pull before cached inputs work.
ARG NODE_VERSION=24

# BEGIN RUNNER MODEL BUNDLE
ARG PYTHON_VERSION=3.13

FROM --platform=$BUILDPLATFORM python:${PYTHON_VERSION}-slim-bookworm AS runner-model-bundle-download
COPY --link deploy/runner-model-bundle/fetch.py deploy/runner-model-bundle/LICENSE /build/
COPY --link controller/shared/builtin-laya-manifest.json /build/model-manifest.json
RUN --mount=type=cache,target=/var/cache/laya,sharing=locked \
    python /build/fetch.py /build/model-manifest.json /opt/models/laya/english /var/cache/laya

# Release builds replace this stage with the published bundle by digest.
FROM scratch AS runner_model_bundle
COPY --link --from=runner-model-bundle-download /opt/models/ /opt/models/
# END RUNNER MODEL BUNDLE

FROM node:${NODE_VERSION}-bookworm-slim AS node-runtime

# The JavaScript bundle is platform-independent. Use native build tools while
# still shipping the target platform's Node executable.
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-bookworm-slim AS guardctl-build
WORKDIR /build/controller
COPY --link controller/package.json controller/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci --no-audit --no-fund
COPY --link controller/src/cli ./src/cli
COPY --link controller/tsconfig.cli.json ./
COPY --link controller/scripts/build-guardctl.mjs ./scripts/
RUN npm run build:cli

FROM python:${PYTHON_VERSION}-slim-bookworm AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/
ENV UV_LINK_MODE=copy UV_NO_DEV=1 UV_PROJECT_ENVIRONMENT=/opt/tasklattice/venv UV_PYTHON_DOWNLOADS=0
WORKDIR /build
COPY --link pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked uv sync --locked --no-install-project

FROM dependencies AS laya-dependencies
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked uv sync --locked --no-install-project --extra builtin-laya

FROM python:${PYTHON_VERSION}-slim-bookworm AS runner-base
ENV PATH="/opt/tasklattice/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GUARD_RUNNER_STATE_PATH=/var/lib/tasklattice/guard-runner
WORKDIR /opt/tasklattice/guard-runner
# Keep common troubleshooting commands available inside Runner Pods.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        dnsutils \
        iproute2 \
        iputils-ping \
        jq \
        less \
        libstdc++6 \
        netcat-openbsd \
        openssl \
        procps \
        vim-tiny \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --no-create-home runner \
    && mkdir -p /var/lib/tasklattice/guard-runner \
    && chown -R 65532:65532 /var/lib/tasklattice/guard-runner
# Runner contains the complete data plane: runtime host, NeMo toolkit, policy
# materialization, and the Default Runner compiler. Only the bundled management
# CLI is included; the Controller server, UI and node_modules stay out.
COPY --link --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --link --from=node-runtime /usr/local/LICENSE /usr/local/share/licenses/guardctl/NODE_LICENSE
COPY --link --chmod=0555 --from=guardctl-build /build/controller/dist-cli/guardctl.cjs /usr/local/bin/guardctl
COPY --link --from=guardctl-build /build/controller/dist-cli/THIRD_PARTY_LICENSES.txt /usr/local/share/licenses/guardctl/THIRD_PARTY_LICENSES.txt
COPY --link runner ./runner
ARG TALI_BUILD_INFO
ENV TALI_BUILD_INFO=${TALI_BUILD_INFO}
USER 65532:65532
EXPOSE 8091
VOLUME ["/var/lib/tasklattice/guard-runner"]
CMD ["uvicorn", "runner.main:app", "--host", "0.0.0.0", "--port", "8091"]

FROM runner-base AS runtime-base
COPY --link --from=dependencies /opt/tasklattice/venv /opt/tasklattice/venv

FROM runner-base AS runtime
COPY --link --from=laya-dependencies /opt/tasklattice/venv /opt/tasklattice/venv
COPY --link --from=runner_model_bundle /opt/models/ /opt/models/
ENV GUARD_BUILTIN_LAYA_MODEL_PATH=/opt/models/laya/english
