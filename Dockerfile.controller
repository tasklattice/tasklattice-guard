# Use the BuildKit-bundled Dockerfile frontend so local installation does not
# require a separate docker.io/docker/dockerfile pull before cached inputs work.
ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /build/controller
COPY --link controller/package.json controller/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked npm ci --no-audit --no-fund
COPY --link controller ./
COPY --link proto /build/proto
RUN npm run build
RUN npm prune --omit=dev --omit=optional --no-audit --no-fund

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production \
    CONTROLLER_HTTP_PORT=8080 \
    CONTROLLER_GRPC_PORT=9090 \
    CONTROLLER_UI_DIST=/opt/tasklattice/guard-controller/dist \
    CONTROLLER_POLICY_CATALOG_DIR=/opt/tasklattice/guard-controller/policy-catalog \
    CONTROLLER_MIGRATIONS_PATH=/opt/tasklattice/guard-controller/server/db/migrations \
    CONTROLLER_PROTO_PATH=/opt/tasklattice/guard-controller/proto/tasklattice/guard/control/v1/runner_control.proto \
    TALI_HELM_CHART=/opt/tali/helm/tali-guard.tgz
WORKDIR /opt/tasklattice/guard-controller
RUN apt-get update \
    && apt-get install --yes --no-install-recommends antiword ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --no-create-home controller
COPY --link --from=build /build/controller/package.json ./
COPY --link --from=build /build/controller/node_modules ./node_modules
COPY --link --from=build /build/controller/dist ./dist
COPY --link --from=build /build/controller/dist-server ./dist-server
COPY --link --from=build /build/controller/server/db/migrations ./server/db/migrations
COPY --link --from=build /build/proto ./proto
COPY --link runner/toolkit/policy_library/assets ./policy-catalog
COPY --link dist/runtime-chart/tali-guard.tgz /opt/tali/helm/tali-guard.tgz
USER 65532:65532
EXPOSE 8080 9090
CMD ["node", "dist-server/server/index.js"]
