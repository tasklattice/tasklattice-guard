{
  "name": "@tasklattice/guard-controller",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ui": "vite --host 0.0.0.0 --port 8092",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "tsc -b tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "auth:bootstrap": "tsx server/bootstrap-admin.ts",
    "typecheck": "tsc -b tsconfig.app.json --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "test": "vitest run --environment jsdom",
    "test:control-plane": "vitest run --environment jsdom",
    "test:server": "vitest run server",
    "audit:production": "npm audit --omit=dev --omit=optional"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.14",
    "@fontsource/chivo-mono": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@hono/node-server": "^2.1.1",
    "@hono/prometheus": "^1.0.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^9.1.2",
    "@xyflow/react": "^12.11.2",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-querybuilder": "^8.22.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "undici": "7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
